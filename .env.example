# Copy to .env.local and fill in real values. Never commit real secrets.
# Variables are added here as each phase needs them.

# Phase 2 – Keystatic
# Production always uses GitHub mode. Development uses local mode unless this
# is set to "github" (needed once to create the GitHub App).
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# GitHub App credentials (see docs/contingut.md). Required in Vercel.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Phase 3 – Vercel Blob (audio uploads from the migration script)
# BLOB_READ_WRITE_TOKEN=

# Phase 4 – Contact form (Web3Forms access key, see docs/decisions/0004).
# Read at build time; without it the contact page shows the email address.
# NEXT_PUBLIC_FORM_ACCESS_KEY=

# Phase 5 – Canonical site URL for metadata, sitemap and JSON-LD.
# Defaults to https://caemontserrat.cat.
# NEXT_PUBLIC_SITE_URL=
